{
  "name": "robocasa-control",
  "version": "1.0.0",
  "private": false,
  "type": "module",
  "description": "Control a RoboCasa kitchen simulation from chat: MuJoCo motion planning, a config panel and a live view, as a DeepSeek Harness plugin.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "worker.py",
    "planner.py",
    "doctor.py",
    "viewer.py",
    "self_check.py",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "INSTALL.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "engines": {
    "dsh": ">=0.1.0"
  },
  "scripts": {
    "check": "node --check index.js && node --check client.js",
    "test": "python3 self_check.py"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "robocasa",
    "robosuite",
    "mujoco",
    "robotics",
    "simulation"
  ],
  "author": "only-one-over",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/only-one-over/robocasa-control.git"
  },
  "bugs": {
    "url": "https://github.com/only-one-over/robocasa-control/issues"
  },
  "homepage": "https://github.com/only-one-over/robocasa-control#readme"
}
