{
  "name": "@local/robocasa-control",
  "version": "0.24.0",
  "private": true,
  "type": "module",
  "description": "Control a RoboCasa kitchen simulation from chat.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "worker.py",
    "planner.py",
    "doctor.py",
    "viewer.py",
    "self_check.py",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "engines": {
    "dsh": ">=0.1.0"
  },
  "scripts": {
    "check": "node --check index.js && node --check client.js",
    "test": "python3 self_check.py"
  }
}
